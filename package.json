{
  "name": "api-test-pyramid",
  "version": "1.0.0",
  "description": "A small Library REST API tested at every level of the test pyramid: unit, integration, contract and performance.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amelia-cmyk/api-test-pyramid.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
